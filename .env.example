# App environment variables
# Copy this file to .env.local and replace the placeholder with your real
# Neon PostgreSQL connection string.
DATABASE_URL=

# Example (real value lives in .env.local, NOT committed):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
